# ==============================================================
# Supabase & Database Environment Configuration (Template)
# Copy this file to .env and fill in your actual Supabase credentials
# ==============================================================

# 1. Supabase Project URL & Anon Key (Frontend / Public)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# 2. Supabase Service Role Key (Backend / Admin Only - Never expose to client)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# 3. PostgreSQL Database Connection (Prisma ORM / Direct SQL)
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection URI
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres?sslmode=require"

# 4. Direct Database URL (for Prisma migrations if connection pooling is used)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres?sslmode=require"

# ==============================================================
# MyanMyanPay Sandbox Configuration
# Generated from: https://developers.myanmyanpay.com/applications
# ==============================================================
NEXT_PUBLIC_MMPAY_PUBLISHABLE_KEY="pk_test_xxxxxxxx"
MMPAY_SECRET_KEY="sk_test_xxxxxxxx"
